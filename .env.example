PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/bogolive
JWT_SECRET=your-jwt-secret-key-change-this-in-production
CLIENT_URL=http://localhost:3000
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# OTP Verification Configuration (SMS & WhatsApp)
# ==============================================================================
# In dev mode (true), OTPs are logged in the terminal with zero cost and no external API needed.
OTP_DEV_MODE=true
OTP_HMAC_SECRET=your-otp-hmac-secret-key

# OTP Security & Rate Limiting
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=900

# Provider Selection: 'console' | 'smsbd' | 'twilio' | 'custom'
OTP_SMS_PROVIDER=console
OTP_WHATSAPP_PROVIDER=console
OTP_SMS_FALLBACK_PROVIDER=
OTP_WHATSAPP_FALLBACK_PROVIDER=

# BulkSMSBD (Bangladesh SMS Provider)
SMSBD_API_KEY=your_smsbd_api_key
SMSBD_SENDER_ID=your_sender_id
SMSBD_API_URL=http://bulksmsbd.net/api/smsapi

# Twilio (Global SMS & WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+14155238886

# Custom Webhook / HTTP Gateway Provider
CUSTOM_SMS_URL=https://api.yourprovider.com/sms
CUSTOM_SMS_API_KEY=your_custom_sms_key
CUSTOM_WHATSAPP_URL=https://api.yourprovider.com/whatsapp
CUSTOM_WHATSAPP_API_KEY=your_custom_whatsapp_key
